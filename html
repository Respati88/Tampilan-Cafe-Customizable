        /* Filter Handlers */
        function filterCategory(cat) {
            state.activeCategory = cat;
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-brand-primary', 'text-white', 'shadow-sm');
                btn.classList.add('bg-white', 'text-brand-textDark');
            });
            const activeBtn = document.getElementById(`cat-${cat}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-white', 'text-brand-textDark');
                activeBtn.classList.add('bg-brand-primary', 'text-white', 'shadow-sm');
            }

            // Update title
            const titleMap = {
                'all': 'Semua Menu Kafe',
                'coffee': 'Kopi Artisan & Espresso',
                'non-coffee': 'Non-Coffee & Fresh Tea',
                'main-dish': 'Main Dish & Pastas',
                'snack': 'Snacks & Light Bites',
                'dessert': 'Desserts & Croissants'
            };
            document.getElementById('sectionTitle').innerText = titleMap[cat] || 'Menu Kafe';
            renderMenuGrid();
        }

        function handleSearch(val) {
            state.searchQuery = val;
            renderMenuGrid();
        }

        function toggleBestSellerOnly() {
            state.bestSellerOnly = !state.bestSellerOnly;
            const btn = document.getElementById('btnBestSeller');
            if (state.bestSellerOnly) {
                btn.classList.add('bg-amber-500', 'text-white');
            } else {
                btn.classList.remove('bg-amber-500', 'text-white');
            }
            renderMenuGrid();
        }

        function setOrderType(type) {
            state.orderType = type;
            ['DineIn', 'Takeaway', 'Delivery'].forEach(t => {
                const btn = document.getElementById(`btn${t}`);
                if (t.toLowerCase() === type.replace('-', '')) {
                    btn.className = 'px-3 py-1.5 rounded-xl transition-all duration-200 bg-white text-brand-primary shadow-sm';
                } else {
                    btn.className = 'px-3 py-1.5 rounded-xl transition-all duration-200 text-stone-600 hover:text-stone-900';
                }
            });
            showToast(`Metode pesanan diubah ke ${type.toUpperCase()}`);
        }

        function openModal(itemId) {
            const item = MENU_DATA.find(i => i.id === itemId);
            if (!item) return;

            state.activeModalItem = item;
            state.modalQty = 1;

            document.getElementById('modalTitle').innerText = item.name;
            document.getElementById('modalBasePrice').innerText = formatRupiah(item.price);
            document.getElementById('modalDescription').innerText = item.description;
            document.getElementById('modalImg').src = item.image;
            document.getElementById('modalCategoryBadge').innerText = item.category.toUpperCase();
            document.getElementById('modalNotes').value = '';

            // Toggle customization options based on food vs beverage
            const tempGrp = document.getElementById('tempOptionGroup');
            const sugarGrp = document.getElementById('sugarOptionGroup');
            const milkGrp = document.getElementById('milkOptionGroup');
            const spicyGrp = document.getElementById('spicyOptionGroup');

            if (item.subType === 'beverage') {
                tempGrp.classList.remove('hidden');
                sugarGrp.classList.remove('hidden');
                milkGrp.classList.remove('hidden');
                spicyGrp.classList.add('hidden');
            } else {
                tempGrp.classList.add('hidden');
                sugarGrp.classList.add('hidden');
                milkGrp.classList.add('hidden');
                spicyGrp.classList.remove('hidden');
            }

            updateModalPrice();
            document.getElementById('customModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
        }

        function updateModalQty(delta) {
            state.modalQty = Math.max(1, state.modalQty + delta);
            document.getElementById('modalQtyDisplay').innerText = state.modalQty;
            updateModalPrice();
        }

        function updateModalPrice() {
            if (!state.activeModalItem) return;
            let base = state.activeModalItem.price;

            // Check milk extra
            if (state.activeModalItem.subType === 'beverage') {
                const milkSelect = document.getElementById('milkChoice');
                const milkExtra = parseInt(milkSelect.options[milkSelect.selectedIndex].getAttribute('data-price') || 0);
                base += milkExtra;
            }

            const total = base * state.modalQty;
            document.getElementById('modalTotalPrice').innerText = formatRupiah(total);
        }

        document.getElementById('milkChoice').addEventListener('change', updateModalPrice);

        function confirmAddToCart() {
            const item = state.activeModalItem;
            if (!item) return;

            let customText = [];
            if (item.subType === 'beverage') {
                const temp = document.querySelector('input[name="temperature"]:checked').value;
                const sugar = document.querySelector('input[name="sugar"]:checked').value;
                const milkSelect = document.getElementById('milkChoice');
                const milk = milkSelect.value;
                customText.push(`${temp}`, `Sugar: ${sugar}`, `${milk}`);
            } else {
                const spicy = document.querySelector('input[name="spicy"]:checked').value;
                customText.push(`Pedas: ${spicy}`);
            }

            const notes = document.getElementById('modalNotes').value.trim();
            if (notes) customText.push(`Catatan: ${notes}`);

            // Calculate extra pricing
            let extraPrice = 0;
            if (item.subType === 'beverage') {
                const milkSelect = document.getElementById('milkChoice');
                extraPrice += parseInt(milkSelect.options[milkSelect.selectedIndex].getAttribute('data-price') || 0);
            }

            const cartItem = {
                cartId: Date.now(),
                id: item.id,
                name: item.name,
                price: item.price + extraPrice,
                qty: state.modalQty,
                customization: customText.join(' • '),
                image: item.image
            };

            state.cart.push(cartItem);
            updateCartUI();
            closeModal();
            showToast(`${item.name} berhasil ditambahkan!`);
        }

        function toggleCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            drawer.classList.toggle('hidden');
        }

        function updateCartUI() {
            const countBadge = document.getElementById('cartBadgeCount');
            const totalItems = state.cart.reduce((acc, curr) => acc + curr.qty, 0);
            countBadge.innerText = totalItems;

            const container = document.getElementById('cartItemsContainer');

            if (state.cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-stone-400">
                        <i class="fa-solid fa-basket-shopping text-4xl mb-3"></i>
                        <p class="text-xs font-semibold">Keranjang kamu masih kosong</p>
                    </div>
                `;
            } else {
                container.innerHTML = state.cart.map(item => `
                    <div class="pt-3 flex gap-3 items-center">
                        <img src="${item.image}" alt="${item.name}" class="w-14 h-14 object-cover rounded-xl bg-stone-100">
                        <div class="flex-1">
                            <h4 class="font-bold text-xs text-stone-900">${item.name}</h4>
                            <p class="text-[10px] text-stone-400 mt-0.5">${item.customization}</p>
                            <span class="font-extrabold text-xs text-brand-primary block mt-1">${formatRupiah(item.price)} x ${item.qty}</span>
                        </div>
                        <button onclick="removeCartItem(${item.cartId})" class="text-stone-400 hover:text-red-500 p-2">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </div>
                `).join('');
            }

            calculateCartSummary();
        }

        function removeCartItem(cartId) {
            state.cart = state.cart.filter(i => i.cartId !== cartId);
            updateCartUI();
        }

        function calculateCartSummary() {
            const subtotal = state.cart.reduce((acc, curr) => acc + (curr.price * curr.qty), 0);
            const discount = subtotal * (state.promoDiscountPercent / 100);
            const tax = (subtotal - discount) * 0.10; // Resto Tax 10%
            const grandTotal = (subtotal - discount) + tax;

            document.getElementById('summarySubtotal').innerText = formatRupiah(subtotal);
            document.getElementById('summaryTax').innerText = formatRupiah(tax);
            document.getElementById('summaryTotal').innerText = formatRupiah(grandTotal);

            if (state.promoDiscountPercent > 0) {
                document.getElementById('promoDiscountRow').style.display = 'flex';
                document.getElementById('summaryDiscount').innerText = `-${formatRupiah(discount)}`;
            } else {
                document.getElementById('promoDiscountRow').style.display = 'none';
            }
        }

        function applyPromoCode() {
            const code = document.getElementById('promoInput').value.trim().toUpperCase();
            if (code === 'GENZ20') {
                state.appliedPromo = 'GENZ20';
                state.promoDiscountPercent = 20;
                calculateCartSummary();
                showToast('Promo Diskon 20% Berhasil Diterapkan!');
            } else {
                showToast('Kode promo tidak valid!');
            }
        }

        function openCheckoutModal() {
            if (state.cart.length === 0) {
                showToast('Keranjang kamu masih kosong!');
                return;
            }
            toggleCartDrawer();
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        function processFinalPayment() {
            const name = document.getElementById('custName').value.trim();
            if (!name) {
                showToast('Silakan isi nama kamu terlebih dahulu');
                return;
            }

            closeCheckoutModal();
            state.cart = [];
            state.promoDiscountPercent = 0;
            updateCartUI();

            showToast(`Terima kasih ${name}! Pesanan kamu sedang disiapkan barista 🎉`);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        function resetFilters() {
            state.searchQuery = '';
            document.getElementById('searchInput').value = '';
            filterCategory('all');
        }

        // Initialize App on Page Load
        window.onload = function() {
            renderMenuGrid();
            updateCartUI();
        };
    </script>
</body>
</html>
