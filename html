        // Format Currency Helper
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
        }

        function renderMenuGrid() {
            const grid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');
            
            // Filter logic
            let filtered = MENU_DATA.filter(item => {
                const matchCategory = (state.activeCategory === 'all') || 
                                      (state.activeCategory === 'beverage' && (item.category === 'coffee' || item.category === 'non-coffee')) ||
                                      (item.category === state.activeCategory);
                const matchSearch = item.name.toLowerCase().includes(state.searchQuery.toLowerCase()) || 
                                    item.description.toLowerCase().includes(state.searchQuery.toLowerCase());
                const matchBestSeller = !state.bestSellerOnly || item.isBestSeller;

                return matchCategory && matchSearch && matchBestSeller;
            });

            // Update Counter
            document.getElementById('itemCount').innerText = `${filtered.length} Items`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            // Render Cards
