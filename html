<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nook & Brew Co. - Aesthetic Cafe & Eatery</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            bg: '#FAF7F5',
                            card: '#FFFFFF',
                            primary: '#2D3A34', // Deep Matcha / Pine Green
                            accent: '#E07A5F',  // Warm Terracotta
                            cream: '#F3EDE6',
                            textDark: '#1C1917',
                            textMuted: '#78716C'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #FAF7F5;
            color: #1C1917;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #FAF7F5;
        }
        ::-webkit-scrollbar-thumb {
            background: #D6CEC7;
            border-radius: 10px;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-brand-accent selection:text-white pb-20 md:pb-0">

    <!-- Top Announcement Bar -->
    <div class="bg-brand-primary text-white text-xs py-2 px-4 text-center font-medium flex justify-center items-center gap-2">
        <span class="bg-brand-accent text-white px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider">PROMO GEN-Z</span>
        <span>Gunakan kode promo <strong class="underline decoration-wavy decoration-brand-accent">GENZ20</strong> untuk diskon 20% pertama kamu! ✨</span>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-brand-bg/90 backdrop-blur-md border-b border-stone-200/60 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            
            <!-- Logo -->
            <a href="#" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-2xl bg-brand-primary text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:scale-105 transition-transform duration-300">
                    N
                </div>
                <div>
                    <span class="font-extrabold text-lg sm:text-xl text-brand-textDark tracking-tight block leading-tight">Nook & Brew<span class="text-brand-accent">.</span></span>
                    <span class="text-[10px] text-brand-textMuted uppercase tracking-widest font-semibold block">Aesthetic Cafe & Culinary</span>
                </div>
            </a>

            <!-- Quick Search Bar (Desktop) -->
            <div class="hidden md:flex flex-1 max-w-md mx-8 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-stone-400"></i>
                <input type="text" id="searchInput" oninput="handleSearch(this.value)" placeholder="Cari Matchalatte, Truffle Pasta, Burger..." 
                       class="w-full bg-stone-100 hover:bg-stone-200/70 focus:bg-white text-sm pl-11 pr-4 py-2.5 rounded-2xl border border-transparent focus:border-brand-primary/30 outline-none transition-all duration-200">
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-3">
                <!-- Order Mode Pill Toggle -->
                <div class="bg-stone-200/70 p-1 rounded-2xl hidden lg:flex items-center text-xs font-semibold">
                    <button onclick="setOrderType('dine-in')" id="btnDineIn" class="px-3 py-1.5 rounded-xl transition-all duration-200 bg-white text-brand-primary shadow-sm">
                        <i class="fa-solid fa-utensils mr-1.5"></i> Dine-In
                    </button>
                    <button onclick="setOrderType('takeaway')" id="btnTakeaway" class="px-3 py-1.5 rounded-xl transition-all duration-200 text-stone-600 hover:text-stone-900">
                        <i class="fa-solid fa-bag-shopping mr-1.5"></i> Takeaway
                    </button>
                    <button onclick="setOrderType('delivery')" id="btnDelivery" class="px-3 py-1.5 rounded-xl transition-all duration-200 text-stone-600 hover:text-stone-900">
                        <i class="fa-solid fa-motorcycle mr-1.5"></i> Delivery
                    </button>
                </div>

                <!-- Spotify Vibe Button -->
                <a href="https://spotify.com" target="_blank" title="Dengarkan Playlist Kafe Kami" class="p-2.5 bg-stone-100 hover:bg-emerald-100 text-emerald-700 rounded-2xl transition-all flex items-center justify-center">
                    <i class="fa-brands fa-spotify text-lg"></i>
                </a>

                <!-- Cart Trigger Button -->
                <button onclick="toggleCartDrawer()" class="relative bg-brand-primary text-white p-3 sm:px-4 sm:py-2.5 rounded-2xl font-medium text-sm flex items-center gap-2 hover:bg-stone-800 transition-all duration-200 shadow-md">
                    <i class="fa-solid fa-basket-shopping text-base"></i>
                    <span class="hidden sm:inline font-semibold">Pesanan</span>
                    <span id="cartBadgeCount" class="bg-brand-accent text-white text-xs font-bold px-2 py-0.5 rounded-full min-w-[20px] text-center">0</span>
                </button>
            </div>
        </div>

        <!-- Mobile Search Input Bar -->
        <div class="px-4 pb-3 md:hidden">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-stone-400"></i>
                <input type="text" oninput="handleSearch(this.value)" placeholder="Cari makanan atau minuman favorit..." 
                       class="w-full bg-stone-100 text-sm pl-11 pr-4 py-2.5 rounded-2xl border border-transparent focus:border-brand-primary/30 outline-none">
            </div>
        </div>
    </header>

    <!-- Hero Banner Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-stone-900 via-brand-primary to-stone-900 text-white p-6 sm:p-10 shadow-2xl">
            <!-- Background Aesthetic Overlay -->
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-brand-accent/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute right-1/3 top-0 w-48 h-48 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="relative z-10 max-w-2xl">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-semibold mb-4 text-emerald-300 border border-white/10">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Open Everyday 08:00 - 22:00 WIB • Wifi 100Mbps
                </div>
                <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight mb-3">
                    Taste The Vibe, <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-300 via-amber-200 to-emerald-300">Savor The Moments.</span>
                </h1>
                <p class="text-stone-300 text-xs sm:text-base font-normal mb-6 leading-relaxed">
                    Seduh kopi racikan artisan barista, paduan mocktail menyegarkan, serta hidangan Main Dish premium pilihan Gen-Z. Siap menemani jam nugas maupun nongkrong santai.
                </p>

                <!-- Quick Category Highlights Pills -->
                <div class="flex flex-wrap items-center gap-2 pt-2">
                    <span class="text-xs text-stone-400 mr-2 font-medium">Populer:</span>
                    <button onclick="filterCategory('beverage')" class="bg-white/10 hover:bg-white/20 text-xs text-stone-200 px-3 py-1.5 rounded-full transition-all">☕ Specialty Coffee</button>
                    <button onclick="filterCategory('main-dish')" class="bg-white/10 hover:bg-white/20 text-xs text-stone-200 px-3 py-1.5 rounded-full transition-all">🍝 Truffle Pastas</button>
                    <button onclick="filterCategory('dessert')" class="bg-white/10 hover:bg-white/20 text-xs text-stone-200 px-3 py-1.5 rounded-full transition-all">🥐 Croissants</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Filter Bar (Sticky) -->
    <section class="sticky top-20 z-30 bg-brand-bg/95 backdrop-blur-md py-4 border-b border-stone-200/60 my-4">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between gap-4">
                
                <!-- Horizontal Scrollable Category Pills -->
                <div class="flex items-center gap-2 overflow-x-auto hide-scrollbar py-1 text-sm font-medium w-full" id="categoryContainer">
                    <button onclick="filterCategory('all')" id="cat-all" class="category-btn active bg-brand-primary text-white px-5 py-2.5 rounded-2xl whitespace-nowrap shadow-sm transition-all duration-200 font-semibold text-xs sm:text-sm flex items-center gap-2">
                        <i class="fa-solid fa-border-all"></i> Semua Menu
                    </button>
                    <button onclick="filterCategory('coffee')" id="cat-coffee" class="category-btn bg-white hover:bg-stone-100 text-brand-textDark border border-stone-200 px-5 py-2.5 rounded-2xl whitespace-nowrap transition-all duration-200 text-xs sm:text-sm flex items-center gap-2">
                        <span>☕</span> Coffee Selection
                    </button>
                    <button onclick="filterCategory('non-coffee')" id="cat-non-coffee" class="category-btn bg-white hover:bg-stone-100 text-brand-textDark border border-stone-200 px-5 py-2.5 rounded-2xl whitespace-nowrap transition-all duration-200 text-xs sm:text-sm flex items-center gap-2">
                        <span>🍵</span> Non-Coffee & Tea
                    </button>
                    <button onclick="filterCategory('main-dish')" id="cat-main-dish" class="category-btn bg-white hover:bg-stone-100 text-brand-textDark border border-stone-200 px-5 py-2.5 rounded-2xl whitespace-nowrap transition-all duration-200 text-xs sm:text-sm flex items-center gap-2">
                        <span>🍝</span> Main Dish
                    </button>
                    <button onclick="filterCategory('snack')" id="cat-snack" class="category-btn bg-white hover:bg-stone-100 text-brand-textDark border border-stone-200 px-5 py-2.5 rounded-2xl whitespace-nowrap transition-all duration-200 text-xs sm:text-sm flex items-center gap-2">
                        <span>🍟</span> Snacks & Bites
                    </button>
                    <button onclick="filterCategory('dessert')" id="cat-dessert" class="category-btn bg-white hover:bg-stone-100 text-brand-textDark border border-stone-200 px-5 py-2.5 rounded-2xl whitespace-nowrap transition-all duration-200 text-xs sm:text-sm flex items-center gap-2">
                        <span>🍰</span> Sweets & Dessert
                    </button>
                </div>

                <!-- Diet / Tag Quick Toggles -->
                <div class="hidden lg:flex items-center gap-2 border-l border-stone-300 pl-4 min-w-fit">
                    <button onclick="toggleBestSellerOnly()" id="btnBestSeller" class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200/80 px-3 py-2 rounded-xl font-medium transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-fire text-amber-500"></i> Best Seller
                    </button>
                </div>

            </div>
        </div>
    </section>

    <!-- Main Menu Content Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex-1">
        
        <!-- Category Title & Counter -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 id="sectionTitle" class="text-2xl font-bold text-brand-textDark tracking-tight">Semua Menu Kafe</h2>
                <p id="sectionSubtitle" class="text-xs text-brand-textMuted mt-0.5">Pilihan hidangan utama & minuman segar untuk menemani harimu</p>
            </div>
            <span id="itemCount" class="text-xs font-semibold bg-stone-200 text-stone-700 px-3 py-1 rounded-full">10 Items</span>
        </div>

        <!-- Product Cards Grid -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Dynamic JavaScript Product Injection -->
        </div>

        <!-- Empty Search State -->
        <div id="emptyState" class="hidden text-center py-16">
            <div class="w-20 h-20 bg-stone-200 text-stone-400 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                <i class="fa-solid fa-mug-hot"></i>
            </div>
            <h3 class="text-lg font-bold text-stone-800">Menu Tidak Ditemukan</h3>
            <p class="text-xs text-stone-500 max-w-sm mx-auto mt-1">Maaf, kata kunci atau filter yang kamu cari belum tersedia. Coba cari menu menarik lainnya!</p>
            <button onclick="resetFilters()" class="mt-4 bg-brand-primary text-white text-xs font-semibold px-4 py-2 rounded-xl">Reset Filter</button>
        </div>

    </main>

    <!-- Product Customization Modal -->
    <div id="customModal" class="fixed inset-0 z-50 hidden bg-stone-900/60 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 transition-opacity">
        <div class="bg-white w-full sm:max-w-lg rounded-t-3xl sm:rounded-3xl max-h-[90vh] flex flex-col overflow-hidden shadow-2xl animate-in slide-in-from-bottom duration-300">
            
            <!-- Modal Header with Image -->
            <div class="relative h-48 sm:h-56 bg-stone-100 overflow-hidden">
                <img id="modalImg" src="" alt="Product" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=600&q=80';" class="w-full h-full object-cover">
                <button onclick="closeModal()" class="absolute top-3 right-3 bg-white/80 hover:bg-white text-stone-800 w-9 h-9 rounded-full flex items-center justify-center shadow-md backdrop-blur-md transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                <div class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full" id="modalCategoryBadge">
                    Category
                </div>
            </div>

            <!-- Modal Body (Scrollable Options) -->
            <div class="p-6 overflow-y-auto flex-1 space-y-6">
                <div>
                    <div class="flex justify-between items-start">
                        <h3 id="modalTitle" class="text-xl font-bold text-stone-900">Item Title</h3>
                        <span id="modalBasePrice" class="text-lg font-extrabold text-brand-accent">Rp 0</span>
                    </div>
                    <p id="modalDescription" class="text-xs text-stone-500 mt-1.5 leading-relaxed">Detailed description goes here.</p>
                </div>

                <!-- Customization Form Options -->
                <form id="customizationForm" class="space-y-5">
                    
                    <!-- Beverage Temperature Option (If Applicable) -->
                    <div id="tempOptionGroup" class="space-y-2">
                        <label class="block text-xs font-bold uppercase text-stone-500 tracking-wider">Suhu Minuman</label>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="cursor-pointer">
                                <input type="radio" name="temperature" value="Iced" checked class="peer hidden">
                                <div class="p-2.5 text-center text-xs font-semibold rounded-xl border border-stone-200 peer-checked:border-brand-primary peer-checked:bg-stone-900 peer-checked:text-white transition-all">
                                    ❄️ Iced (Dingin)
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="temperature" value="Hot" class="peer hidden">
                                <div class="p-2.5 text-center text-xs font-semibold rounded-xl border border-stone-200 peer-checked:border-brand-primary peer-checked:bg-stone-900 peer-checked:text-white transition-all">
                                    🔥 Hot (Hangat)
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Sugar Level Option (Beverages) -->
                    <div id="sugarOptionGroup" class="space-y-2">
                        <label class="block text-xs font-bold uppercase text-stone-500 tracking-wider">Tingkat Manis (Sugar Level)</label>
                        <div class="grid grid-cols-4 gap-2 text-xs">
                            <label class="cursor-pointer">
                                <input type="radio" name="sugar" value="100% Normal" checked class="peer hidden">
                                <div class="p-2 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    100% Normal
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="sugar" value="70% Less" class="peer hidden">
                                <div class="p-2 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    70% Less
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="sugar" value="30% Low" class="peer hidden">
                                <div class="p-2 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    30% Low
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="sugar" value="0% Sugar Free" class="peer hidden">
                                <div class="p-2 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    0% No Sugar
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Milk Base Option (Beverages) -->
                    <div id="milkOptionGroup" class="space-y-2">
                        <label class="block text-xs font-bold uppercase text-stone-500 tracking-wider">Pilihan Susu / Base</label>
                        <select id="milkChoice" class="w-full bg-stone-100 text-xs rounded-xl p-3 border border-stone-200 font-medium outline-none">
                            <option value="Fresh Milk (Dairy)" data-price="0">Fresh Milk (Standard)</option>
                            <option value="Oatmilk (Oatside)" data-price="7000">Oatmilk (+Rp 7.000)</option>
                            <option value="Almond Milk" data-price="9000">Almond Milk (+Rp 9.000)</option>
                            <option value="Soy Milk" data-price="6000">Soy Milk (+Rp 6.000)</option>
                        </select>
                    </div>

                    <!-- Spicy Level Option (Main Dish) -->
                    <div id="spicyOptionGroup" class="space-y-2 hidden">
                        <label class="block text-xs font-bold uppercase text-stone-500 tracking-wider">Tingkat Pedas (Spiciness)</label>
                        <div class="grid grid-cols-3 gap-2 text-xs">
                            <label class="cursor-pointer">
                                <input type="radio" name="spicy" value="Mild / Tidak Pedas" checked class="peer hidden">
                                <div class="p-2.5 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    🌶️ Mild (Sedang)
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="spicy" value="Medium" class="peer hidden">
                                <div class="p-2.5 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    🌶️🌶️ Medium
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="spicy" value="Extra Hot" class="peer hidden">
                                <div class="p-2.5 text-center rounded-xl border border-stone-200 peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-accent font-semibold transition-all">
                                    🔥 Extra Hot
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Special Notes for Barista / Chef -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold uppercase text-stone-500 tracking-wider">Catatan Khusus</label>
                        <input type="text" id="modalNotes" placeholder="Misal: Pisahkan es, sauce di wadah terpisah..." class="w-full bg-stone-100 text-xs rounded-xl p-3 border border-stone-200 outline-none">
                    </div>

                </form>
            </div>

            <!-- Modal Footer (Quantity & Add Button) -->
            <div class="p-4 bg-stone-50 border-t border-stone-200 flex items-center justify-between gap-4">
                <div class="flex items-center bg-white border border-stone-300 rounded-2xl p-1">
                    <button onclick="updateModalQty(-1)" class="w-8 h-8 rounded-xl bg-stone-100 hover:bg-stone-200 flex items-center justify-center font-bold text-stone-700">-</button>
                    <span id="modalQtyDisplay" class="w-10 text-center font-bold text-sm">1</span>
                    <button onclick="updateModalQty(1)" class="w-8 h-8 rounded-xl bg-stone-100 hover:bg-stone-200 flex items-center justify-center font-bold text-stone-700">+</button>
                </div>

                <button onclick="confirmAddToCart()" class="flex-1 bg-brand-primary text-white py-3 px-4 rounded-2xl font-bold text-xs sm:text-sm shadow-md hover:bg-stone-800 transition-all flex items-center justify-between">
                    <span>Tambah Pesanan</span>
                    <span id="modalTotalPrice">Rp 0</span>
                </button>
            </div>

        </div>
    </div>

    <!-- Cart Slide-Over Drawer -->
    <div id="cartDrawer" class="fixed inset-0 z-50 hidden transition-all duration-300">
        <!-- Backdrop -->
        <div onclick="toggleCartDrawer()" class="absolute inset-0 bg-stone-900/50 backdrop-blur-xs"></div>
        
        <!-- Drawer Body -->
        <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl flex flex-col justify-between z-10">
            
            <!-- Drawer Header -->
            <div class="p-5 border-b border-stone-200 flex items-center justify-between bg-brand-bg">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-brand-primary text-white flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                    <h3 class="font-bold text-stone-900 text-lg">Keranjang Kamu</h3>
                </div>
                <button onclick="toggleCartDrawer()" class="text-stone-400 hover:text-stone-700 p-2 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Drawer Cart Items (Scrollable) -->
            <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-5 space-y-4 divide-y divide-stone-100">
                <!-- Cart Items Injected by JS -->
            </div>

            <!-- Drawer Footer & Payment Summary -->
            <div class="p-5 bg-stone-50 border-t border-stone-200 space-y-4">
                
                <!-- Promo Code Input -->
                <div class="flex gap-2">
                    <input type="text" id="promoInput" placeholder="Kode Promo (e.g. GENZ20)" class="flex-1 bg-white uppercase text-xs rounded-xl p-2.5 border border-stone-300 font-semibold outline-none">
                    <button onclick="applyPromoCode()" class="bg-stone-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-black transition-all">Gunakan</button>
                </div>
                
                <!-- Calculation Breakdown -->
                <div class="space-y-1.5 text-xs text-stone-600">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span id="summarySubtotal" class="font-semibold text-stone-800">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-emerald-600 font-medium" id="promoDiscountRow" style="display: none;">
                        <span>Diskon Promo (GENZ20)</span>
                        <span id="summaryDiscount">-Rp 0</span>
                    </div>
                    <div class="flex justify-between">
